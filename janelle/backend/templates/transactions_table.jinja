{% autoescape true %}
<div id="transactions-table"
     hx-get="/transactions-backend/ui/transactions?page={{ page }}"
     hx-trigger="transactionsChanged from:body"
     hx-include="#transaction-filters, #transactions-page-size"
     hx-swap="outerHTML">
    {% if notice %}
    <p class="transaction-notice{% if notice_kind == 'error' %} transaction-notice-error{% endif %}"
       role="{{ 'alert' if notice_kind == 'error' else 'status' }}">
        {{ notice }}
    </p>
    {% endif %}
    <div class="transactions-table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Merchant</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Category</th>
                    <th class="transactions-actions-heading">
                        <span class="screen-reader-only">Actions</span>
                    </th>
                </tr>
            </thead>
            <tbody id="transactions">
                {% if error %}
                <tr>
                    <td colspan="6">{{ error }}</td>
                </tr>
                {% else %}
                {% for transaction in transactions %}
                <tr>
                    <td>{{ transaction.get("date", "")[:16] }}</td>
                    <td>{{ transaction.get("merchant", "") }}</td>
                    <td>{{ transaction.get("description", "") }}</td>
                    <td>{{ "%.2f"|format(transaction.get("amount")) }}</td>
                    <td>{{ transaction.get("category_name") or transaction.get("category_id") or "Uncategorised" }}</td>
                    <td class="transactions-actions-cell">
                        {% set category_name = transaction.get("category_name") %}
                        {% if multi_agent_enabled and transaction.get("id") is not none
                              and (not category_name or category_name|lower == "uncategorised") %}
                        <button type="button"
                                class="table-action-button"
                                aria-label="Suggest a category for the transaction at {{ transaction.get('merchant', '') }} on {{ transaction.get('date', '')[:16] }}"
                                hx-post="/transactions-backend/ui/transactions/{{ transaction.get('id') }}/agent-review"
                                hx-target="#agent-review"
                                hx-swap="innerHTML"
                                hx-on::response-error="document.getElementById('agent-review').innerHTML = event.detail.xhr.responseText"
                                hx-disabled-elt="this">
                            Suggest category
                        </button>
                        {% endif %}
                        {% if transaction.get("id") is not none %}
                        <button type="button"
                                class="table-action-button danger-action-button"
                                aria-label="Delete transaction at {{ transaction.get('merchant', '') }} on {{ transaction.get('date', '')[:16] }}"
                                hx-delete="/transactions-backend/ui/transactions/{{ transaction.get('id') }}?page={{ page }}"
                                hx-confirm="Delete the {{ '%.2f'|format(transaction.get('amount')) }} transaction at {{ transaction.get('merchant', '') }}? This cannot be undone."
                                hx-target="#transactions-table"
                                hx-swap="outerHTML"
                                hx-include="#transaction-filters, #transactions-page-size"
                                hx-sync="#transactions-table:replace"
                                hx-disabled-elt="this">
                            Delete
                        </button>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6">
                        {% if filters_active %}
                        No transactions match your filters.
                        {% else %}
                        No transactions found.
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>

    <div class="transactions-pagination">
        <div class="transactions-page-size">
            <label for="transactions-page-size">Rows per page</label>
            <select id="transactions-page-size"
                    name="page_size"
                    hx-get="/transactions-backend/ui/transactions"
                    hx-trigger="change"
                    hx-target="#transactions-table"
                    hx-swap="outerHTML"
                    hx-include="#transaction-filters"
                    hx-sync="#transactions-table:replace">
                {% for size in page_sizes %}
                <option value="{{ size }}"{% if size == page_size %} selected{% endif %}>{{ size }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="transactions-page-details">
            <p class="transactions-page-count" aria-live="polite">
                Showing {{ first_transaction }}-{{ last_transaction }} of {{ total_transactions }} transactions
            </p>
            <nav class="transactions-page-navigation"
                 aria-label="Transactions pages">
                <button id="previous-transactions-page"
                        class="transactions-page-button"
                        type="button"
                        aria-label="Previous page"
                        aria-controls="transactions"
                        {% if has_previous %}
                        hx-get="/transactions-backend/ui/transactions?page={{ page - 1 }}"
                        hx-target="#transactions-table"
                        hx-swap="outerHTML"
                        hx-include="#transaction-filters, #transactions-page-size"
                        hx-sync="#transactions-table:replace"
                        {% else %}
                        disabled
                        {% endif %}>
                    <span aria-hidden="true">&larr;</span>
                </button>
                <span class="transactions-page-number">
                    Page {{ page }} of {{ total_pages }}
                </span>
                <button id="next-transactions-page"
                        class="transactions-page-button"
                        type="button"
                        aria-label="Next page"
                        aria-controls="transactions"
                        {% if has_next %}
                        hx-get="/transactions-backend/ui/transactions?page={{ page + 1 }}"
                        hx-target="#transactions-table"
                        hx-swap="outerHTML"
                        hx-include="#transaction-filters, #transactions-page-size"
                        hx-sync="#transactions-table:replace"
                        {% else %}
                        disabled
                        {% endif %}>
                    <span aria-hidden="true">&rarr;</span>
                </button>
            </nav>
        </div>
    </div>
</div>
{% endautoescape %}

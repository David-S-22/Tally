<div class="dashboard-panel ai-suggestion-panel" id="ai-suggestion-container" {% if job_id %}hx-get="/savings-backend/ai-suggestion/jobs/{{ job_id }}" hx-trigger="every 5s" hx-target="#ai-suggestion-container" hx-swap="outerHTML" aria-busy="true"{% elif loading %}hx-post="/savings-backend/ai-suggestion/jobs" hx-trigger="load" hx-target="#ai-suggestion-container" hx-swap="outerHTML"{% endif %}>
    <div class="panel-header">
        <h2>AI Suggestion</h2>
        <button type="button" class="btn-refresh" {% if loading %}disabled{% endif %}
                hx-post="/savings-backend/ai-suggestion/jobs"
                hx-include="[name='suggestion']" 
                hx-target="#ai-suggestion-container" 
                hx-indicator="#ai-suggestion-container" 
                hx-swap="outerHTML">
            Refresh
        </button>
    </div>
    <div class="ai-suggestion-body" id="ai-suggestion">
        {% set is_valid = not loading and suggestion and not suggestion.startswith("Error") and not suggestion.startswith("You don't have") and not suggestion.startswith("No transactions found") and not suggestion.startswith("Insufficient context") and suggestion != "No current AI suggestion available." %}
        <textarea class="ai-suggestion-textbox" {% if is_valid %}name="suggestion"{% endif %} rows="3" readonly placeholder="Waiting for AI suggestion...">{{ "Waiting for AI suggestion..." if loading else (suggestion or "No current AI suggestion available.") }}</textarea>
        <div class="ai-suggestion-meta-section">
            <div class="ai-meta-item">
                <span class="ai-meta-label">Sources:</span>
                <span class="ai-meta-value">{{ sources if is_valid and sources else ("Waiting for AI suggestion..." if loading else "None") }}</span>
            </div>
            <div class="ai-meta-item">
                <span class="ai-meta-label">Confidence:</span>
                <span class="confidence-badge confidence-{{ (confidence | lower) if is_valid and confidence else 'none' }}">{{ confidence if is_valid and confidence else ("Waiting..." if loading else "None") }}</span>
            </div>
            <div class="ai-meta-item">
                <span class="ai-meta-label">Reviewer:</span>
                {% if reviewer %}
                {% set verdict_key = (reviewer.get('verdict') or reviewer.get('status') or '') | lower %}
                <span class="reviewer-badge{% if verdict_key %} verdict-{{ verdict_key }}{% endif %}">{{ (reviewer.get('verdict') or reviewer.get('status', 'unavailable')) | replace('_', ' ') | capitalize | e }}</span>
                {% else %}
                <span class="ai-meta-value">{{ 'Waiting...' if loading else 'Unavailable' }}</span>
                {% endif %}
            </div>
        </div>
        {% if reviewer %}
        <div class="reviewer-feedback">
            <p>{{ (reviewer.get('review') or reviewer.get('error') or 'Reviewer feedback is unavailable.') | e }}</p>
            {% if reviewer.get('risks') %}
            <strong>Risks</strong>
            <ul>{% for risk in reviewer['risks'] %}<li>{{ risk | e }}</li>{% endfor %}</ul>
            {% endif %}
            {% if reviewer.get('recommendations') %}
            <strong>Recommendations</strong>
            <ul>{% for recommendation in reviewer['recommendations'] %}<li>{{ recommendation | e }}</li>{% endfor %}</ul>
            {% endif %}
        </div>
        {% endif %}
        <div class="ai-suggestion-feedback-section">
            <label for="ai-feedback-input">Feedback on this suggestion:</label>
            <textarea id="ai-feedback-input" class="ai-suggestion-feedback-input" 
                      name="feedback" rows="2" 
                      placeholder="{{ 'Explain why you are accepting or rejecting this suggestion...' if is_valid else 'Waiting for AI suggestion...' if loading else 'Feedback disabled: No valid suggestion available.' }}" 
                      {% if is_valid %}required{% else %}disabled readonly{% endif %}></textarea>
            <div class="ai-suggestion-actions">
                <button type="button" class="btn-accept" 
                        {% if is_valid %}
                        hx-post="/savings-backend/ai-suggestion/action?accepted=true" 
                        hx-include="closest #ai-suggestion-container" 
                        hx-target="#ai-suggestion-container" 
                        hx-indicator="#ai-suggestion-container" 
                        hx-swap="outerHTML"
                        {% else %}
                        disabled
                        {% endif %}>
                    ✓ Accept
                </button>
                <button type="button" class="btn-cancel" 
                        {% if is_valid %}
                        hx-post="/savings-backend/ai-suggestion/action?accepted=false" 
                        hx-include="closest #ai-suggestion-container" 
                        hx-target="#ai-suggestion-container" 
                        hx-indicator="#ai-suggestion-container" 
                        hx-swap="outerHTML"
                        {% else %}
                        disabled
                        {% endif %}>
                    ✗ Reject
                </button>
            </div>
        </div>
    </div>
</div>
